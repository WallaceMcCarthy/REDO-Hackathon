{
  "name": "utah-fit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "seed:prod": "tsx scripts/seed.ts --prod",
    "seed:assessor": "tsx scripts/data/assessor_homes.ts",
    "seed:assessor:prod": "tsx scripts/data/assessor_homes.ts --prod",
    "test:e2e": "playwright test",
    "test:e2e:cross": "playwright test -c playwright.cross.config.ts",
    "test:e2e:prod": "E2E_BASE_URL=https://cmascope.com playwright test"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.96",
    "convex": "^1.49.0",
    "dotenv": "^18.0.9",
    "maplibre-gl": "^6.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "vitest": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "convex-test": "^0.0.67",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
